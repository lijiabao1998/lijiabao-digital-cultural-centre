---
// 文章: every post, newest first. Each post has its own page.
import Base from '@layouts/Base.astro';
import Arrow from '@components/Arrow.astro';
import { BLOG, SITE } from '@data/site';
import { getPosts, postPath, postUrl } from '@lib/blog';
import { breadcrumbs } from '@lib/schema';
import { formatDate, isoDay } from '@lib/works';

const posts = await getPosts();
const description = `${SITE.name}定期發表的文章。`;

const schema = [
  breadcrumbs([
    { name: '首頁', path: '/' },
    { name: BLOG.name, path: BLOG.path },
  ]),
  {
    '@type': 'Blog',
    '@id': `${SITE.url}${BLOG.path}#blog`,
    name: `${BLOG.name}（${BLOG.nameEn}）`,
    description,
    url: `${SITE.url}${BLOG.path}`,
    inLanguage: SITE.locale,
    publisher: { '@id': `${SITE.url}/#organization` },
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      '@id': `${postUrl(p)}#post`,
      headline: p.data.title,
      url: postUrl(p),
    })),
  },
];
---

<!-- Until the first post is published the page stays out of search indexes, the sitemap and the navigation. -->
<Base title={BLOG.name} description={description} markdown="/blog.md" schema={schema} noindex={posts.length === 0}>
  <header class="wrap page-head">
    <ol class="crumbs" aria-label="目前位置">
      <li><a href="/">首頁</a></li>
      <li aria-current="page">{BLOG.name}</li>
    </ol>
    <h1>{BLOG.name}</h1>
    <p class="lead">{BLOG.intro}也可以用 <a href="/feed.xml">Atom feed</a> 訂閱。</p>
  </header>

  <div class="wrap list">
    {
      posts.length === 0 ? (
        <p class="empty">第一篇文章準備中。</p>
      ) : (
        posts.map((p) => (
          <article class="item">
            <time datetime={isoDay(p.data.date)}>{formatDate(p.data.date)}</time>
            <div>
              <h2>
                <a href={postPath(p)}>{p.data.title}</a>
              </h2>
              <p class="item__summary">{p.data.summary}</p>
              {p.data.tags.length > 0 && (
                <ul class="tags" aria-label="主題">
                  {p.data.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              )}
              <a class="arrow-link" href={postPath(p)} aria-label={`閱讀：${p.data.title}`}>
                閱讀全文 <Arrow />
              </a>
            </div>
          </article>
        ))
      )
    }
  </div>
</Base>

<style>
  .lead a {
    font-weight: 700;
  }
  .list {
    padding-bottom: var(--section);
  }
  .empty {
    padding-block: clamp(28px, 3.6vw, 48px);
    border-top: 3px solid var(--ink);
    font-size: 1.125rem;
    font-weight: 600;
  }
  .item {
    display: grid;
    grid-template-columns: minmax(170px, 0.28fr) minmax(0, 1fr);
    gap: 10px clamp(24px, 5vw, 80px);
    padding-block: clamp(28px, 3.6vw, 48px);
    border-top: 3px solid var(--ink);
  }
  .item time {
    font-size: 0.9375rem;
    font-weight: 800;
    line-height: 2.2;
  }
  .item h2 {
    font-size: clamp(1.5rem, 2.8vw, 2.25rem);
    line-height: 1.25;
  }
  .item h2 a {
    text-decoration: none;
  }
  .item h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }
  .item__summary {
    max-width: 40em;
    margin-top: 12px;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.75;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
    padding: 0;
    list-style: none;
  }
  .item .arrow-link {
    margin-top: 22px;
  }
  @media (max-width: 760px) {
    .item {
      grid-template-columns: 1fr;
    }
  }
</style>
