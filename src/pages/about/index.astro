---
import Base from '@layouts/Base.astro';
import Arrow from '@components/Arrow.astro';
import Mark from '@components/Mark.astro';
import { ABOUT_SECTIONS, STATUS_LEGEND } from '@data/about';
import { AREAS, SITE, STATUS } from '@data/site';
import { breadcrumbs } from '@lib/schema';

const schema = [
  breadcrumbs([
    { name: '首頁', path: '/' },
    { name: '關於我們', path: '/about/' },
  ]),
  {
    '@type': 'AboutPage',
    name: `關於${SITE.name}`,
    url: `${SITE.url}/about/`,
    inLanguage: SITE.locale,
    about: { '@id': `${SITE.url}/#organization` },
  },
];
---

<Base title="關於我們" description={SITE.tagline} markdown="/about.md" schema={schema}>
  <header class="wrap page-head">
    <ol class="crumbs" aria-label="目前位置">
      <li><a href="/">首頁</a></li>
      <li aria-current="page">關於我們</li>
    </ol>
    <h1>關於我們</h1>
    <p class="lead statement">{SITE.tagline}</p>
    <p class="statement-en">{SITE.taglineEn}</p>
  </header>

  <div class="wrap body">
    {
      ABOUT_SECTIONS.map((s) => (
        <section class="block" id={s.id} aria-labelledby={`h-${s.id}`}>
          <h2 id={`h-${s.id}`}>{s.title}</h2>
          <div class="block__body">
            {s.paragraphs.map((p) => (
              <p>{p}</p>
            ))}

            {s.id === 'what' && (
              <ul class="areas">
                {AREAS.map((a) => (
                  <li>
                    <a href={`/${a.id}/`}>
                      <span class="areas__no">{a.no}</span>
                      <b>{a.name}</b>
                      <span>{a.intro}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}

            {s.id === 'how' && (
              <dl class="legend">
                {STATUS_LEGEND.map((l) => (
                  <div>
                    <dt>
                      <span class="status" data-status={l.id}>
                        {STATUS[l.id].label}
                      </span>
                    </dt>
                    <dd>{l.meaning}</dd>
                  </div>
                ))}
              </dl>
            )}

            {s.id === 'mark' && (
              <div class="marks">
                <div class="marks__tile">
                  <Mark size={120} />
                </div>
                <div class="marks__tile marks__tile--lilac">
                  <Mark size={120} accent="var(--paper)" />
                </div>
                <div class="marks__tile marks__tile--ink">
                  <Mark size={120} />
                </div>
              </div>
            )}

            {s.id === 'maintain' && (
              <p class="links">
                <a class="arrow-link" href={SITE.github} rel="noopener">
                  GitHub <Arrow />
                </a>
                <a class="arrow-link" href={SITE.sisterSite.url} rel="noopener">
                  {SITE.sisterSite.name} <Arrow />
                </a>
              </p>
            )}

            {s.id === 'ai' && (
              <ul class="files">
                <li><a href="/llms.txt">/llms.txt</a><span>網站總覽與所有頁面的連結</span></li>
                <li><a href="/llms-full.txt">/llms-full.txt</a><span>全站文字，合併成一份</span></li>
                <li><a href="/api/works.json">/api/works.json</a><span>作品目錄（JSON）</span></li>
                <li><a href="/feed.xml">/feed.xml</a><span>Atom feed</span></li>
                <li><a href="/feed.json">/feed.json</a><span>JSON feed</span></li>
                <li><a href="/sitemap.xml">/sitemap.xml</a><span>所有網址</span></li>
                <li><a href="/robots.txt">/robots.txt</a><span>爬蟲規則：全部允許</span></li>
              </ul>
            )}
          </div>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .statement {
    max-width: 24em;
    font-size: clamp(1.375rem, 2.6vw, 2.125rem);
    font-weight: 800;
    line-height: 1.5;
  }
  .statement-en {
    max-width: 40em;
    margin-top: 14px;
    color: var(--muted);
  }
  .body {
    padding-bottom: var(--section);
  }
  .block {
    display: grid;
    grid-template-columns: minmax(200px, 0.34fr) minmax(0, 1fr);
    gap: 16px clamp(24px, 5vw, 80px);
    padding-block: clamp(28px, 4vw, 56px);
    border-top: 3px solid var(--ink);
    scroll-margin-top: 24px;
  }
  .block h2 {
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
  }
  .block__body {
    max-width: 46em;
  }
  .block__body > p {
    font-size: 1.0938rem;
    line-height: 1.95;
  }
  .block__body > p + p {
    margin-top: 1em;
  }

  .areas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3px;
    margin-top: 28px;
    padding: 3px;
    background: var(--ink);
  }
  .areas a {
    display: grid;
    gap: 4px;
    height: 100%;
    padding: 20px 22px 22px;
    background: var(--paper);
    font-size: 0.9063rem;
    line-height: 1.7;
    text-decoration: none;
    transition:
      background 0.18s ease,
      color 0.18s ease;
  }
  .areas a:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .areas__no {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  .areas b {
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1.3;
  }

  .legend {
    margin-top: 28px;
    border-top: 1px solid var(--ink);
  }
  .legend > div {
    display: grid;
    grid-template-columns: 8em minmax(0, 1fr);
    gap: 16px;
    padding-block: 13px;
    border-bottom: 1px solid var(--rule);
    font-size: 0.9375rem;
  }

  .marks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3px;
    margin-top: 28px;
  }
  .marks__tile {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border: 1px solid var(--ink);
  }
  .marks__tile--lilac {
    background: var(--lilac-300);
    border-color: var(--lilac-300);
  }
  .marks__tile--ink {
    background: var(--ink);
    color: var(--paper);
  }
  .marks__tile :global(svg) {
    width: 46%;
    height: auto;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 40px;
    margin-top: 24px;
  }

  .files {
    margin-top: 28px;
    border-top: 1px solid var(--ink);
  }
  .files li {
    display: grid;
    grid-template-columns: 11em minmax(0, 1fr);
    gap: 16px;
    padding-block: 13px;
    border-bottom: 1px solid var(--rule);
    font-size: 0.9375rem;
  }
  .files a {
    font-weight: 800;
  }
  .files span {
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .block,
    .areas {
      grid-template-columns: 1fr;
    }
    .legend > div,
    .files li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
