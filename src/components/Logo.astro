---
import Mark from './Mark.astro';
import { SITE } from '@data/site';

interface Props {
  /** `footer` is the larger, inverted lock-up. */
  variant?: 'header' | 'footer';
}
const { variant = 'header' } = Astro.props;
---

<a class:list={['logo', `logo--${variant}`]} href="/" aria-label={`${SITE.name} 首頁`}>
  <Mark size={variant === 'footer' ? 56 : 46} />
  <span class="logo__text">
    <span class="logo__name">{SITE.name}</span>
    <span class="logo__en">{SITE.nameEn}</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: inherit;
    text-decoration: none;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .logo__name {
    font-size: 1.375rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.02em;
  }
  .logo__en {
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.135em;
    text-transform: uppercase;
  }
  .logo--footer .logo__name {
    font-size: 1.625rem;
  }
  .logo--footer .logo__en {
    font-size: 0.6875rem;
  }
  @media (max-width: 420px) {
    .logo__name {
      font-size: 1.1875rem;
    }
    .logo__en {
      font-size: 0.5625rem;
      letter-spacing: 0.1em;
    }
  }
</style>
