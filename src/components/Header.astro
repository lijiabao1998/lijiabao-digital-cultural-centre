---
// Site header.
// Row 1: a quiet line with the English description and the secondary links.
// Row 2: the logo and the four areas, each with a dropdown.
//
// The dropdowns are native <details name="…"> elements: they open without JavaScript and only one can be
// open at a time. The script below adds what the platform does not: close on outside click, on Escape, and
// when focus leaves; plus the mobile menu button.
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';
import { AREAS, UTILITY_NAV } from '@data/site';
import { areaOf, getWorks, workPath } from '@lib/works';

const MAX_LINKS = 6;
const works = await getWorks();
const path = Astro.url.pathname;

const menus = AREAS.map((area) => {
  const list = works.filter((w) => areaOf(w) === area.id);
  return { area, list: list.slice(0, MAX_LINKS), total: list.length, current: path.startsWith(`/${area.id}/`) };
});
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header" data-header>
  <div class="bar">
    <div class="wrap bar__in">
      <p class="bar__tag">An independent digital cultural centre</p>
      <ul class="bar__links">
        {
          UTILITY_NAV.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="wrap main">
    <Logo />

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-btn>
      <span class="sr-only">選單</span>
      <span class="menu-btn__lines" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>

    <nav class="nav" id="site-nav" aria-label="主要導覽">
      <ul class="nav__list">
        {
          menus.map(({ area, list, total, current }) => (
            <li class="nav__item">
              <details class="dd" name="site-nav">
                <summary class="dd__trigger" data-current={current ? '' : undefined}>
                  <span>{area.name}</span>
                  <svg class="dd__chev" viewBox="0 0 14 9" aria-hidden="true">
                    <path d="M1 1.2 7 7.2l6-6" fill="none" stroke="currentColor" stroke-width="2.4" />
                  </svg>
                </summary>
                <div class="dd__panel">
                  <p class="dd__label">
                    {area.no} — {area.nameEn}
                  </p>
                  <a class="dd__overview" href={`/${area.id}/`}>
                    <span>{area.name}展區總覽</span>
                    <Arrow />
                  </a>
                  {list.length > 0 ? (
                    <ul class="dd__list">
                      {list.map((w) => (
                        <li>
                          <a href={workPath(w)}>{w.data.title}</a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="dd__empty">展品整理中</p>
                  )}
                  {total > MAX_LINKS && (
                    <a class="dd__all" href={`/${area.id}/`}>
                      全部 {total} {area.unit}
                    </a>
                  )}
                </div>
              </details>
            </li>
          ))
        }
      </ul>

      <ul class="nav__utility">
        {
          UTILITY_NAV.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--ink);
  }

  /* row 1 */
  .bar {
    border-bottom: 1px solid var(--rule);
  }
  .bar__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 44px;
  }
  .bar__tag {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .bar__links {
    display: flex;
    gap: clamp(18px, 2.4vw, 34px);
  }
  .bar__links a {
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }
  .bar__links a:hover,
  .bar__links a[aria-current] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  /* row 2 */
  .main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 96px;
  }
  .nav__list {
    display: flex;
    gap: clamp(20px, 2.8vw, 44px);
  }
  .nav__item {
    position: relative;
  }
  .nav__utility {
    display: none;
  }

  .dd__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding-block: 10px;
    font-size: 1.125rem;
    font-weight: 800;
    line-height: 1.2;
    cursor: pointer;
    list-style: none;
    user-select: none;
    border-bottom: 3px solid transparent;
  }
  .dd__trigger::-webkit-details-marker {
    display: none;
  }
  .dd__chev {
    width: 0.78em;
    height: 0.5em;
    flex: none;
    transition: transform 0.18s ease;
  }
  .dd__trigger:hover,
  .dd[open] > .dd__trigger,
  .dd__trigger[data-current] {
    border-bottom-color: var(--ink);
  }
  .dd[open] .dd__chev {
    transform: rotate(180deg);
  }

  /* The panel: white, one hairline of black, square, no shadow. */
  .dd__panel {
    position: absolute;
    top: calc(100% + 12px);
    left: -20px;
    z-index: 60;
    width: max-content;
    min-width: 264px;
    max-width: min(340px, 92vw);
    padding: 16px 20px 18px;
    background: var(--paper);
    border: 1px solid var(--ink);
  }
  .nav__item:nth-last-child(-n + 2) .dd__panel {
    left: auto;
    right: -20px;
  }
  .dd__label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .dd__overview {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 8px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--ink);
    font-size: 1.0625rem;
    font-weight: 800;
    line-height: 1.4;
    text-decoration: none;
  }
  .dd__overview :global(svg) {
    width: 1.5em;
    height: 0.75em;
    flex: none;
    transition: transform 0.2s ease;
  }
  .dd__overview:hover :global(svg) {
    transform: translateX(4px);
  }
  .dd__list {
    margin-top: 10px;
  }
  .dd__list a,
  .dd__all {
    display: block;
    padding-block: 5px;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.45;
    text-decoration: none;
  }
  .dd__overview:hover span,
  .dd__list a:hover,
  .dd__all:hover {
    text-decoration: underline;
  }
  .dd__all {
    margin-top: 8px;
    padding-top: 10px;
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .dd__all:hover {
    color: var(--ink);
  }
  .dd__empty {
    margin-top: 10px;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  /* menu button (mobile only): a black square that echoes the mark */
  .menu-btn {
    display: none;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
  }
  .menu-btn__lines {
    display: grid;
    gap: 5px;
    width: 22px;
    margin: auto;
  }
  .menu-btn__lines i {
    display: block;
    height: 3px;
    background: currentColor;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }
  [data-open] .menu-btn__lines i:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  [data-open] .menu-btn__lines i:nth-child(2) {
    opacity: 0;
  }
  [data-open] .menu-btn__lines i:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    .bar {
      display: none;
    }
    .main {
      min-height: 76px;
      flex-wrap: wrap;
    }
    .menu-btn {
      display: block;
    }
    .nav {
      display: none;
      flex-basis: 100%;
      padding-bottom: 28px;
    }
    [data-open] .nav {
      display: block;
    }
    .nav__list {
      display: block;
      border-top: 3px solid var(--ink);
    }
    .nav__item {
      border-bottom: 1px solid var(--rule);
    }
    .dd__trigger {
      display: flex;
      justify-content: space-between;
      padding-block: 18px;
      font-size: 1.375rem;
      border-bottom: 0;
    }
    .dd__panel,
    .nav__item:nth-last-child(-n + 2) .dd__panel {
      position: static;
      width: auto;
      max-width: none;
      padding: 0 0 20px;
      border: 0;
    }
    .nav__utility {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 28px;
      margin-top: 24px;
    }
    .nav__utility a {
      font-weight: 700;
    }
  }
</style>

<noscript>
  <style>
    @media (max-width: 900px) {
      .site-header .nav {
        display: block;
      }
      .site-header .menu-btn {
        display: none;
      }
    }
  </style>
</noscript>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const dropdowns = [...header.querySelectorAll<HTMLDetailsElement>('details.dd')];
    const btn = header.querySelector<HTMLButtonElement>('[data-menu-btn]');
    const desktop = window.matchMedia('(min-width: 901px)');
    const closeAll = () => dropdowns.forEach((d) => (d.open = false));

    // Click anywhere outside an open dropdown closes it.
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      dropdowns.forEach((d) => {
        if (d.open && !d.contains(target)) d.open = false;
      });
    });

    // Tabbing out of a dropdown closes it (desktop only: on mobile they are an accordion).
    dropdowns.forEach((d) =>
      d.addEventListener('focusout', (e) => {
        const next = (e as FocusEvent).relatedTarget as Node | null;
        if (desktop.matches && next && !d.contains(next)) d.open = false;
      }),
    );

    const setMenu = (open: boolean) => {
      header.toggleAttribute('data-open', open);
      btn?.setAttribute('aria-expanded', String(open));
      if (!open) closeAll();
    };
    btn?.addEventListener('click', () => setMenu(!header.hasAttribute('data-open')));

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const open = dropdowns.find((d) => d.open);
      if (open) {
        open.open = false;
        open.querySelector('summary')?.focus();
      } else if (header.hasAttribute('data-open')) {
        setMenu(false);
        btn?.focus();
      }
    });

    desktop.addEventListener('change', () => setMenu(false));
  }
</script>
