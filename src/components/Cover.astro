---
// Generated cover for a work that has no image yet.
// A small floor plan: lilac rooms on a grid, one black L-shaped wall, one violet square.
// The drawing is derived from the work's id, so every work gets its own plan and keeps it.
interface Props {
  seed: string;
}
const { seed } = Astro.props;

// xmur3 hash → mulberry32: small, deterministic, good enough for layout.
function rng(str: string) {
  let h = 1779033703 ^ str.length;
  for (let i = 0; i < str.length; i++) {
    h = Math.imul(h ^ str.charCodeAt(i), 3432918353);
    h = (h << 13) | (h >>> 19);
  }
  let a = (h ^= h >>> 16) >>> 0;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = rng(seed);
const int = (min: number, max: number) => Math.floor(rand() * (max - min + 1)) + min;

const COLS = 16;
const ROWS = 10;
const U = 10; // one grid cell
const tones = ['var(--lilac-200)', 'var(--lilac-300)', 'var(--lilac-200)', 'var(--lilac-50)'];

// Rooms: a handful of grid-aligned rectangles.
const rooms = Array.from({ length: 6 }, (_, i) => {
  const w = int(2, 6);
  const h = int(2, 4);
  return { x: int(0, COLS - w) * U, y: int(0, ROWS - h) * U, w: w * U, h: h * U, fill: tones[i % tones.length] };
});

// The wall: an L whose corner sits somewhere in the lower-left half.
const lx = int(2, 7) * U;
const ly = int(1, 3) * U;
const lh = int(5, 7) * U;
const lw = int(4, 6) * U;
const t = U; // wall thickness
const wall = `M${lx} ${ly}h${t}v${lh - t}h${lw - t}v${t}H${lx}z`;

// The square on show, standing inside the corner.
const sq = { x: lx + t + U, y: ly + lh - t - U - 20, s: 20 };
---

<svg class="cover" viewBox={`0 0 ${COLS * U} ${ROWS * U}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <rect width={COLS * U} height={ROWS * U} fill="var(--lilac-100)"></rect>
  {rooms.map((r) => <rect x={r.x} y={r.y} width={r.w} height={r.h} fill={r.fill} />)}
  <path d={wall} fill="var(--ink)"></path>
  <rect x={sq.x} y={sq.y} width={sq.s} height={sq.s} fill="var(--violet)"></rect>
</svg>
